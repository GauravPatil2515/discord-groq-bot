# Discord Bot Token (From Discord Developer Portal -> Bot -> Reset Token)
DISCORD_BOT_TOKEN=your_discord_bot_token_here

# GroqCloud API Key (From console.groq.com/keys)
GROQ_API_KEY=gsk_your_groq_api_key_here

# Discord Guild (Server) ID (Right-click server in Discord -> Copy Server ID)
DISCORD_GUILD_ID=123456789012345678

# Optional: LLM Model ID on Groq
GROQ_MODEL=qwen/qwen3.8-27b
